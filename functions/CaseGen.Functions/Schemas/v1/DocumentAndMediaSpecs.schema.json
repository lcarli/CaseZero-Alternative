{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentAndMediaSpecs",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "caseId": { "type": "string" },
    "version": { "type": "string" },

    "plannedContradictions": {
      "type": "array",
      "minItems": 0,
      "description": "List of intentionally planned contradictions in the case",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contradictionId": {
            "type": "string",
            "pattern": "^CONTR\\d{3}$",
            "description": "Unique identifier (e.g., CONTR001)"
          },
          "type": {
            "type": "string",
            "enum": ["timeline", "alibi", "evidence_interpretation", "witness_testimony", "forensic_discrepancy"],
            "description": "Type of contradiction"
          },
          "description": {
            "type": "string",
            "description": "What is contradicting and why it matters"
          },
          "involvedDocuments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "DocIds containing conflicting information"
          },
          "involvedEvidences": {
            "type": "array",
            "items": { "type": "string" },
            "description": "EvidenceIds related to this contradiction"
          },
          "involvedSuspects": {
            "type": "array",
            "items": { "type": "string" },
            "description": "SuspectIds affected by this contradiction"
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "resolvingDocuments", "resolvingEvidences", "expectedConclusion"],
            "properties": {
              "method": {
                "type": "string",
                "enum": ["cross_reference", "forensic_evidence", "timeline_analysis", "document_comparison", "witness_credibility"],
                "description": "How this contradiction can be resolved"
              },
              "resolvingDocuments": {
                "type": "array",
                "items": { "type": "string" },
                "description": "DocIds that help resolve the contradiction"
              },
              "resolvingEvidences": {
                "type": "array",
                "items": { "type": "string" },
                "description": "EvidenceIds that help resolve the contradiction"
              },
              "expectedConclusion": {
                "type": "string",
                "description": "What the investigator should conclude after resolution"
              }
            },
            "description": "How this contradiction can be resolved"
          },
          "minimumDifficulty": {
            "type": "string",
            "enum": ["rookie", "detective", "detective2", "sergeant", "lieutenant", "captain", "commander"],
            "description": "Minimum difficulty level for this contradiction"
          }
        },
        "required": [
          "contradictionId",
          "type",
          "description",
          "involvedDocuments",
          "involvedEvidences",
          "involvedSuspects",
          "resolution",
          "minimumDifficulty"
        ]
      }
    },

    "documentSpecs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "docId": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$",
            "description": "Unique identifier in the case"
          },
          "type": {
            "type": "string",
            "enum": [
              "police_report",
              "interview",
              "memo_admin",
              "forensics_report",
              "evidence_log",
              "witness_statement"
            ],
            "description": "Document type"
          },
          "title": {
            "type": "string",
            "description": "Human-readable title"
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Required sections of the document"
          },
          "lengthTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { 
                "type": "integer", 
                "minimum": 50,
                "description": "Minimum word count" 
              },
              "max": { 
                "type": "integer", 
                "minimum": 50,
                "description": "Maximum word count" 
              }
            },
            "description": "Target word range {min, max}"
          },
          "gated": {
            "type": "boolean",
            "default": false,
            "description": "Access-gated document"
          },
          "gatingRule": {
            "type": "object",
            "additionalProperties": false,
            "description": "Unlock rule when gated=true",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "requires_evidence",
                  "requires_document",
                  "requires_decision",
                  "role_required",
                  "manual_unlock",
                  "submit_evidence"
                ]
              },
              "evidenceId": { "type": "string" },
              "docId": { "type": "string" },
              "notes": { "type": "string" }
            },
            "required": ["action"]
          }
        },
        "required": [
          "docId",
          "type",
          "title",
          "sections",
          "lengthTarget",
          "gated"
        ],
        "allOf": [
          {
            "if": { "properties": { "gated": { "const": true } } },
            "then": { "required": ["gatingRule"] }
          },
          {
            "if": { "properties": { "type": { "const": "forensics_report" } } },
            "then": {
              "properties": {
                "sections": {
                  "contains": {
                    "type": "string",
                    "pattern": "(?i)chain of custody"
                  }
                }
              }
            }
          }
        ]
      }
    },

    "mediaSpecs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidenceId": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$",
            "description": "Unique identifier of the media item"
          },
          "role": {
            "type": "string",
            "enum": ["conclusive", "supporting", "ambiguous", "red_herring"],
            "description": "Investigative role of this media evidence"
          },
          "canonical": {
            "type": "boolean",
            "description": "Whether this media represents the canonical (only) visual representation of a physical object"
          },
          "canonicalGroup": {
            "type": "string",
            "description": "Group identifier for media representing the same physical object. All media in a group must share visual consistency."
          },
          "maxVisualVariants": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 1,
            "description": "Maximum number of visual variants allowed for this canonical group. Enforced during media generation."
          },
          "kind": {
            "type": "string",
            "enum": ["photo", "document_scan", "diagram", "audio", "video"],
            "description": "Media type"
          },
          "title": {
            "type": "string",
            "description": "Human-readable title"
          },
          "prompt": {
            "type": "string",
            "description": "Prompt for generating the media"
          },
          "constraints": {
            "type": "object",
            "description": "Additional constraints (lighting, angle, anonymization, etc.)",
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          },
          "deferred": {
            "type": "boolean",
            "default": false,
            "description": "Set to true if the type is not yet supported"
          }
        },
        "required": [
          "evidenceId",
          "kind",
          "title",
          "prompt",
          "constraints",
          "deferred"
        ]
      }
    }
  },
  "required": ["documentSpecs", "mediaSpecs"]
}