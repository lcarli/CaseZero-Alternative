{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casezero.dev/schemas/case.v2.schema.json",
  "title": "CaseZero Case v2.0 Schema",
  "description": "Canonical schema for case.json v2 — single source of truth for the site (frontend + CaseZeroApi). See docs/CASE_JSON_V2_SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "caseId",
    "metadata",
    "assets",
    "emails",
    "suspects",
    "rules",
    "forensicsDefaults",
    "forensicOutcomes",
    "solution",
    "gameMetadata"
  ],
  "properties": {
    "version": { "const": "2.0" },
    "caseId": {
      "type": "string",
      "pattern": "^case_[a-z0-9_]+$"
    },
    "metadata": { "$ref": "#/$defs/Metadata" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Asset" }
    },
    "emails": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Email" }
    },
    "suspects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Suspect" }
    },
    "timeline": {
      "type": "array",
      "items": { "$ref": "#/$defs/TimelineEntry" }
    },
    "temporalEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/TemporalEvent" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/Rule" }
    },
    "forensicsDefaults": { "$ref": "#/$defs/ForensicsDefaults" },
    "forensicOutcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/ForensicOutcome" }
    },
    "solution": { "$ref": "#/$defs/Solution" },
    "gameMetadata": { "$ref": "#/$defs/GameMetadata" }
  },
  "$defs": {
    "Difficulty": {
      "type": "string",
      "enum": ["Rookie", "Detective", "Detective2", "Sergeant", "Lieutenant", "Captain", "Commander"]
    },
    "Rank": { "$ref": "#/$defs/Difficulty" },
    "Visibility": {
      "type": "string",
      "enum": ["initial", "hidden"]
    },
    "AssetIdRef": {
      "type": "string",
      "pattern": "^asset\\.[a-z0-9_]+$"
    },
    "EmailIdRef": {
      "type": "string",
      "pattern": "^email\\.[a-z0-9_]+$"
    },
    "SuspectIdRef": {
      "type": "string",
      "pattern": "^suspect\\.[a-z0-9_]+$"
    },
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "location", "incidentDate", "openedAt", "difficulty", "requiredRank"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 10 },
        "location": { "type": "string" },
        "incidentDate": { "type": "string", "format": "date-time" },
        "openedAt": { "type": "string", "format": "date-time" },
        "difficulty": { "$ref": "#/$defs/Difficulty" },
        "requiredRank": { "$ref": "#/$defs/Rank" },
        "unlockMode": { "type": "string", "enum": ["gated", "all_initial"] },
        "estimatedDurationMinutes": { "type": "integer", "minimum": 5, "maximum": 600 },
        "category": { "type": "string" },
        "briefing": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "victim": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string" },
            "age": { "type": "integer", "minimum": 0 },
            "occupation": { "type": "string" },
            "lastSeen": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "uri", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/AssetIdRef" },
        "type": { "type": "string", "enum": ["photo", "pdf", "audio", "video", "document", "image", "digital", "physical"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "uri": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
        "visibility": { "$ref": "#/$defs/Visibility" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "Email": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "subject", "body", "sentAt", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/EmailIdRef" },
        "from": { "type": "string", "minLength": 1 },
        "to": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ]
        },
        "subject": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "sentAt": { "type": "string", "format": "date-time" },
        "priority": { "type": "string", "enum": ["normal", "high", "urgent"] },
        "visibility": { "$ref": "#/$defs/Visibility" },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/AssetIdRef" }
        },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "Suspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/SuspectIdRef" },
        "name": { "type": "string" },
        "alias": { "type": "string" },
        "age": { "type": "integer", "minimum": 0 },
        "occupation": { "type": "string" },
        "relationship": { "type": "string" },
        "description": { "type": "string" },
        "motive": { "type": "string" },
        "alibi": { "type": "string" },
        "alibiVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["suspect", "cleared", "confirmed_culprit"] },
        "background": { "type": "string" },
        "relatedAssets": { "type": "array", "items": { "$ref": "#/$defs/AssetIdRef" } },
        "photo": { "$ref": "#/$defs/AssetIdRef" },
        "visibility": { "$ref": "#/$defs/Visibility" }
      }
    },
    "TimelineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "event"],
      "properties": {
        "time": { "type": "string", "format": "date-time" },
        "event": { "type": "string" },
        "source": { "type": "string", "enum": ["investigation", "witness", "sensor", "forensic"] },
        "sourceAssetId": { "$ref": "#/$defs/AssetIdRef" },
        "verified": { "type": "boolean" },
        "importance": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
      }
    },
    "TemporalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "triggerAtMinutes", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^tevt\\.[a-z0-9_]+$" },
        "triggerAtMinutes": { "type": "integer", "minimum": 0 },
        "type": { "type": "string", "enum": ["memo", "witness", "alert", "email"] },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emailId": { "$ref": "#/$defs/EmailIdRef" },
            "assetId": { "$ref": "#/$defs/AssetIdRef" },
            "message": { "type": "string" }
          }
        }
      }
    },
    "Rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "trigger", "actions"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^rule\\.[a-z0-9_]+$" },
        "description": { "type": "string" },
        "trigger": { "$ref": "#/$defs/Trigger" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Action" }
        }
      }
    },
    "Trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "forensics_complete",
            "attachment_download",
            "asset_viewed",
            "email_opened",
            "time_elapsed",
            "suspect_viewed",
            "multiple_conditions"
          ]
        },
        "inputAssetId": { "$ref": "#/$defs/AssetIdRef" },
        "analysisType": { "type": "string" },
        "emailId": { "$ref": "#/$defs/EmailIdRef" },
        "assetId": { "$ref": "#/$defs/AssetIdRef" },
        "suspectId": { "$ref": "#/$defs/SuspectIdRef" },
        "atMinutes": { "type": "integer", "minimum": 0 },
        "operator": { "type": "string", "enum": ["AND", "OR"] },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Trigger" }
        }
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "reveal_email",
            "reveal_asset",
            "reveal_suspect",
            "add_email_attachment",
            "send_notification",
            "update_suspect_status",
            "mark_alibi_verified"
          ]
        },
        "emailId": { "$ref": "#/$defs/EmailIdRef" },
        "assetId": { "$ref": "#/$defs/AssetIdRef" },
        "suspectId": { "$ref": "#/$defs/SuspectIdRef" },
        "level": { "type": "string", "enum": ["info", "warn", "critical"] },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["suspect", "cleared", "confirmed_culprit"] },
        "verified": { "type": "boolean" }
      }
    },
    "ForensicsDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysisTypes", "noFindingsEmail"],
      "properties": {
        "analysisTypes": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/AnalysisType" }
        },
        "noFindingsEmail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "from", "subject"],
          "properties": {
            "template": { "type": "string" },
            "from": { "type": "string" },
            "subject": { "type": "string" }
          }
        }
      }
    },
    "AnalysisType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "durationMinutes", "availableFor"],
      "properties": {
        "type": { "type": "string" },
        "durationMinutes": { "type": "integer", "minimum": 1 },
        "availableFor": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "ForensicOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputAssetId", "analysisType", "findings"],
      "properties": {
        "inputAssetId": { "$ref": "#/$defs/AssetIdRef" },
        "analysisType": { "type": "string" },
        "findings": { "type": "boolean" },
        "matchedSuspectId": { "$ref": "#/$defs/SuspectIdRef" },
        "matchedAssetId": { "$ref": "#/$defs/AssetIdRef" },
        "conclusionText": { "type": "string" },
        "resultAssetId": { "$ref": "#/$defs/AssetIdRef" },
        "resultEmailId": { "$ref": "#/$defs/EmailIdRef" }
      }
    },
    "Solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["culpritId", "requiredEvidenceIds", "requiredAnalysisIds", "questions", "minimumScore", "maxAttempts", "partialCreditRules"],
      "properties": {
        "culpritId": { "$ref": "#/$defs/SuspectIdRef" },
        "requiredEvidenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/AssetIdRef" }
        },
        "requiredAnalysisIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^asset\\.[a-z0-9_]+:[A-Za-z0-9_]+$" }
        },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Question" }
        },
        "explanation": { "type": "string" },
        "minimumScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "partialCreditRules": { "$ref": "#/$defs/PartialCreditRules" }
      }
    },
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "options", "correctOptionId"],
      "properties": {
        "id": { "type": "string", "pattern": "^q\\.[a-z0-9_]+$" },
        "prompt": { "type": "string" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^opt\\.[a-z0-9_]+$" },
              "label": { "type": "string" }
            }
          }
        },
        "correctOptionId": { "type": "string", "pattern": "^opt\\.[a-z0-9_]+$" },
        "weight": { "type": "number", "minimum": 0 }
      }
    },
    "PartialCreditRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["culpritWeight", "evidenceWeight", "analysisWeight", "questionsWeight"],
      "properties": {
        "culpritWeight": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceWeight": { "type": "number", "minimum": 0, "maximum": 1 },
        "analysisWeight": { "type": "number", "minimum": 0, "maximum": 1 },
        "questionsWeight": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "GameMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "createdAt"],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "createdAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "contentWarnings": { "type": "array", "items": { "type": "string" } },
        "localizations": { "type": "array", "items": { "type": "string" } },
        "generation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "pipelineVersion": { "type": "string" },
            "model": { "type": "string" },
            "seed": { "type": "integer" },
            "bundleChecksum": { "type": "string" }
          }
        }
      }
    }
  }
}
